# Dependencies
node_modules/
node_modules

# VuePress build output
docs/.vuepress/dist/
docs/.vuepress/.cache/
docs/.vuepress/.temp/

# OS files
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp
*.swo
*~

# Claude Code local tooling (launch.json, scheduled_tasks.lock)
.claude/

# Logs
*.log
npm-debug.log*

# Lock file — tracked for CI reproducibility

# Environment
.env
.env.local

# Asciinema cast working files — only the scrubbed SVGs in
# docs/.vuepress/public/demos/ are committed; the .cast intermediates
# are generated under /tmp/casts/ and removed at the end of each render.
/tmp/casts/
*.cast.raw
*.cast.tmp
docs/.vuepress/public/demos/*.cast

# Python bytecode from scripts/
__pycache__/
*.pyc

# dbt build output and local telemetry id — never committed
**/target/
**/.user.yml
